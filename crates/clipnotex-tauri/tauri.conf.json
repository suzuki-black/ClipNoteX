{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipNoteX",
  "version": "0.1.0",
  "identifier": "com.clipnotex.app",
  "build": {
    "frontendDist": "../../apps/desktop/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "history",
        "title": "ClipNoteX",
        "width": 480,
        "height": 600,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
